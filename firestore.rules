
    // Guardian parental-control/focus manager. Isolated from PinCon school collections.
    function guardianFamilyPath(familyId) {
      return /databases/$(database)/documents/guardianFamilies/$(familyId);
    }

    function guardianDevicePath(familyId, deviceId) {
      return /databases/$(database)/documents/guardianFamilies/$(familyId)/devices/$(deviceId);
    }

    function guardianPairingPath(code) {
      return /databases/$(database)/documents/guardianPairingCodes/$(code);
    }

    function guardianOwner(familyId) {
      return signedIn()
        && exists(guardianFamilyPath(familyId))
        && get(guardianFamilyPath(familyId)).data.ownerUid == request.auth.uid;
    }

    function guardianDevicePrincipal(familyId, deviceId) {
      return signedIn()
        && exists(guardianDevicePath(familyId, deviceId))
        && get(guardianDevicePath(familyId, deviceId)).data.principalUid == request.auth.uid;
    }

    function guardianValidDeviceCreate(familyId, deviceId) {
      return signedIn()
        && request.resource.data.principalUid == request.auth.uid
        && request.resource.data.pairingCode is string
        && request.resource.data.pairingCode.size() >= 12
        && request.resource.data.pairingCode.size() <= 80
        && existsAfter(guardianPairingPath(request.resource.data.pairingCode))
        && getAfter(guardianPairingPath(request.resource.data.pairingCode)).data.familyId == familyId
        && getAfter(guardianPairingPath(request.resource.data.pairingCode)).data.claimed == true
        && getAfter(guardianPairingPath(request.resource.data.pairingCode)).data.claimedByUid == request.auth.uid
        && getAfter(guardianPairingPath(request.resource.data.pairingCode)).data.claimedDeviceId == deviceId;
    }

    function guardianValidDeviceRebind(familyId, deviceId) {
      return signedIn()
        && resource.data.principalUid is string
        && request.resource.data.principalUid == request.auth.uid
        && request.resource.data.pairingCode is string
        && request.resource.data.pairingCode.size() >= 12
        && request.resource.data.pairingCode.size() <= 80
        && request.resource.data.createdAtMillis == resource.data.createdAtMillis
        && request.resource.data.label == resource.data.label
        && request.resource.data.model == resource.data.model
        && request.resource.data.desiredRevision == resource.data.desiredRevision
        && request.resource.data.appliedRevision == resource.data.appliedRevision
        && request.resource.data.focusActive == resource.data.focusActive
        && request.resource.data.usageStatus == resource.data.usageStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'principalUid', 'pairingCode', 'lastSeenAtMillis'
        ])
        && existsAfter(guardianPairingPath(request.resource.data.pairingCode))
        && getAfter(guardianPairingPath(request.resource.data.pairingCode)).data.familyId == familyId
        && getAfter(guardianPairingPath(request.resource.data.pairingCode)).data.claimed == true
        && getAfter(guardianPairingPath(request.resource.data.pairingCode)).data.claimedByUid == request.auth.uid
        && getAfter(guardianPairingPath(request.resource.data.pairingCode)).data.claimedDeviceId == deviceId;
    }

    function guardianValidPolicy() {
      return request.resource.data.keys().hasOnly([
          'revision', 'days', 'startMinuteOfDay', 'endMinuteOfDay', 'zoneId',
          'alwaysAllowed', 'studyAllowed', 'blocked', 'dailyLimitsMillis',
          'temporaryAllowances', 'notifyPackages', 'updatedAtMillis'
        ])
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.days is list
        && request.resource.data.days.size() > 0
        && request.resource.data.days.size() <= 7
        && request.resource.data.days.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && request.resource.data.startMinuteOfDay is int
        && request.resource.data.startMinuteOfDay >= 0
        && request.resource.data.startMinuteOfDay < 1440
        && request.resource.data.endMinuteOfDay is int
        && request.resource.data.endMinuteOfDay >= 0
        && request.resource.data.endMinuteOfDay < 1440
        && request.resource.data.startMinuteOfDay != request.resource.data.endMinuteOfDay
        && request.resource.data.zoneId == 'Asia/Seoul'
        && request.resource.data.alwaysAllowed is list
        && request.resource.data.alwaysAllowed.size() <= 200
        && request.resource.data.studyAllowed is list
        && request.resource.data.studyAllowed.size() <= 200
        && request.resource.data.blocked is list
        && request.resource.data.blocked.size() <= 500
        && request.resource.data.dailyLimitsMillis is map
        && request.resource.data.temporaryAllowances is map
        && request.resource.data.notifyPackages is list
        && request.resource.data.notifyPackages.size() <= 200
        && request.resource.data.updatedAtMillis is int;
    }

    function guardianValidScreenRequest() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'requestedByUid', 'requestedAtMillis', 'status',
          'studentConsentAtMillis', 'stoppedAtMillis', 'frameAtMillis',
          'width', 'height', 'sequence', 'frame'
        ])
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.requestedAtMillis is int
        && request.resource.data.requestedAtMillis > 0
        && request.resource.data.status == 'REQUESTED'
        && request.resource.data.studentConsentAtMillis == 0
        && request.resource.data.stoppedAtMillis == 0
        && request.resource.data.frameAtMillis == 0
        && request.resource.data.width == 0
        && request.resource.data.height == 0
        && request.resource.data.sequence == 0
        && request.resource.data.frame is bytes
        && request.resource.data.frame.size() == 0;
    }

    function guardianValidScreenDeviceUpdate() {
      return request.resource.data.requestedByUid == resource.data.requestedByUid
        && request.resource.data.requestedAtMillis == resource.data.requestedAtMillis
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'studentConsentAtMillis', 'stoppedAtMillis',
          'frameAtMillis', 'width', 'height', 'sequence', 'frame'
        ])
        && request.resource.data.status in ['ACTIVE', 'PAUSED_LOCKED', 'RESUME_REQUIRED', 'STOPPED', 'DENIED', 'FAILED']
        && request.resource.data.studentConsentAtMillis is int
        && request.resource.data.studentConsentAtMillis >= 0
        && request.resource.data.stoppedAtMillis is int
        && request.resource.data.stoppedAtMillis >= 0
        && request.resource.data.frameAtMillis is int
        && request.resource.data.frameAtMillis >= 0
        && request.resource.data.width is int
        && request.resource.data.width >= 0
        && request.resource.data.width <= 1080
        && request.resource.data.height is int
        && request.resource.data.height >= 0
        && request.resource.data.height <= 2400
        && request.resource.data.sequence is int
        && request.resource.data.sequence >= 0
        && request.resource.data.frame is bytes
        && request.resource.data.frame.size() <= 650000
        && (
          (
            request.resource.data.status == 'ACTIVE'
            && request.resource.data.studentConsentAtMillis > 0
            && request.resource.data.stoppedAtMillis == 0
          )
          || (
            request.resource.data.status in ['PAUSED_LOCKED', 'RESUME_REQUIRED', 'STOPPED', 'DENIED', 'FAILED']
            && request.resource.data.stoppedAtMillis > 0
            && request.resource.data.frame.size() == 0
          )
        );
    }

    match /guardianFamilies/{familyId} {
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'createdAtMillis', 'updatedAtMillis'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAtMillis is int
        && request.resource.data.updatedAtMillis is int;
      allow update: if guardianOwner(familyId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAtMillis == resource.data.createdAtMillis
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAtMillis']);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if guardianOwner(familyId) || guardianDevicePrincipal(familyId, deviceId);
        allow create: if guardianValidDeviceCreate(familyId, deviceId)
          && request.resource.data.keys().hasOnly([
            'principalUid', 'pairingCode', 'label', 'model', 'createdAtMillis',
            'lastSeenAtMillis', 'desiredRevision', 'appliedRevision', 'focusActive', 'usageStatus'
          ])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 80
          && request.resource.data.model is string
          && request.resource.data.model.size() <= 120
          && request.resource.data.createdAtMillis is int
          && request.resource.data.lastSeenAtMillis is int
          && request.resource.data.desiredRevision == 0
          && request.resource.data.appliedRevision == 0
          && request.resource.data.focusActive == false
          && request.resource.data.usageStatus == 'UNKNOWN';
        allow update: if (
            guardianDevicePrincipal(familyId, deviceId)
            && request.resource.data.principalUid == resource.data.principalUid
            && request.resource.data.pairingCode == resource.data.pairingCode
            && request.resource.data.createdAtMillis == resource.data.createdAtMillis
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastSeenAtMillis', 'appliedRevision', 'focusActive', 'usageStatus',
              'attentionWatchStatus', 'attentionWatchedCount', 'attentionLastScanAtMillis',
              'attentionLastPackage', 'attentionLastEventAtMillis'
            ])
          ) || (
            guardianOwner(familyId)
            && request.resource.data.principalUid == resource.data.principalUid
            && request.resource.data.pairingCode == resource.data.pairingCode
            && request.resource.data.createdAtMillis == resource.data.createdAtMillis
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'desiredRevision'])
          ) || guardianValidDeviceRebind(familyId, deviceId);
        allow delete: if guardianOwner(familyId);

        match /desired/{policyId} {
          allow read: if guardianOwner(familyId) || guardianDevicePrincipal(familyId, deviceId);
          allow create: if policyId == 'current'
            && guardianOwner(familyId)
            && guardianValidPolicy()
            && request.resource.data.revision == 1;
          allow update: if policyId == 'current'
            && guardianOwner(familyId)
            && guardianValidPolicy()
            && request.resource.data.revision == resource.data.revision + 1;
          allow delete: if guardianOwner(familyId);
        }

        match /push/{pushId} {
          allow read: if pushId == 'current'
            && guardianDevicePrincipal(familyId, deviceId);
          allow create, update: if pushId == 'current'
            && guardianDevicePrincipal(familyId, deviceId)
            && request.resource.data.keys().hasOnly(['token', 'updatedAtMillis'])
            && request.resource.data.token is string
            && request.resource.data.token.size() >= 20
            && request.resource.data.token.size() <= 4096
            && request.resource.data.updatedAtMillis is int
            && request.resource.data.updatedAtMillis > 0;
          allow delete: if guardianOwner(familyId);
        }

        match /screenShare/{shareId} {
          allow read: if shareId == 'current'
            && (guardianOwner(familyId) || guardianDevicePrincipal(familyId, deviceId));
          allow create: if shareId == 'current'
            && guardianOwner(familyId)
            && guardianValidScreenRequest();
          allow update: if shareId == 'current'
            && (
              (
                guardianOwner(familyId)
                && guardianValidScreenRequest()
              )
              || (
                guardianOwner(familyId)
                && resource.data.status in ['REQUESTED', 'ACTIVE']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                && request.resource.data.status == 'STOP_REQUESTED'
              )
              || (
                guardianDevicePrincipal(familyId, deviceId)
                && guardianValidScreenDeviceUpdate()
              )
            );
          allow delete: if guardianOwner(familyId);
        }

        match /attentionEvents/{eventId} {
          allow read: if guardianOwner(familyId) || guardianDevicePrincipal(familyId, deviceId);
          allow create: if guardianDevicePrincipal(familyId, deviceId)
            && request.resource.data.keys().hasOnly([
              'principalUid', 'packageName', 'appLabel', 'eventType',
              'eventAtMillis', 'focusActive', 'source'
            ])
            && request.resource.data.principalUid == request.auth.uid
            && request.resource.data.packageName is string
            && request.resource.data.packageName.size() > 0
            && request.resource.data.packageName.size() <= 250
            && request.resource.data.appLabel is string
            && request.resource.data.appLabel.size() > 0
            && request.resource.data.appLabel.size() <= 120
            && request.resource.data.eventType == 'APP_OPENED'
            && request.resource.data.eventAtMillis is int
            && request.resource.data.eventAtMillis > request.time.toMillis() - 300000
            && request.resource.data.eventAtMillis <= request.time.toMillis() + 60000
            && request.resource.data.focusActive is bool
            && request.resource.data.source == 'USAGE_STATS';
          allow update: if false;
          allow delete: if guardianOwner(familyId);
        }

        match /approvalRequests/{requestId} {
          allow read: if guardianOwner(familyId) || guardianDevicePrincipal(familyId, deviceId);
          allow create: if guardianDevicePrincipal(familyId, deviceId)
            && request.resource.data.keys().hasOnly([
              'principalUid', 'packageName', 'requestedDurationMinutes',
              'requestedAtMillis', 'status', 'resolvedAtMillis', 'allowanceExpiresAtMillis'
            ])
            && request.resource.data.principalUid == request.auth.uid
            && request.resource.data.packageName is string
            && request.resource.data.packageName.size() > 0
            && request.resource.data.packageName.size() <= 250
            && request.resource.data.requestedDurationMinutes is int
            && request.resource.data.requestedDurationMinutes >= 1
            && request.resource.data.requestedDurationMinutes <= 120
            && request.resource.data.requestedAtMillis is int
            && request.resource.data.status == 'PENDING'
            && request.resource.data.resolvedAtMillis == 0
            && request.resource.data.allowanceExpiresAtMillis == 0;
          allow update: if guardianOwner(familyId)
            && request.resource.data.principalUid == resource.data.principalUid
            && request.resource.data.packageName == resource.data.packageName
            && request.resource.data.requestedDurationMinutes == resource.data.requestedDurationMinutes
            && request.resource.data.requestedAtMillis == resource.data.requestedAtMillis
            && request.resource.data.status in ['APPROVED', 'DENIED']
            && request.resource.data.resolvedAtMillis is int
            && request.resource.data.resolvedAtMillis > 0
            && request.resource.data.allowanceExpiresAtMillis is int;
          allow delete: if false;
        }
      }
    }

    match /guardianPairingCodes/{code} {
      allow get: if signedIn()
        && resource.data.expiresAtMillis is int
        && resource.data.expiresAtMillis > request.time.toMillis();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'familyId', 'createdByUid', 'createdAtMillis', 'expiresAtMillis',
          'claimed', 'claimedByUid', 'claimedDeviceId', 'claimedAtMillis'
        ])
        && guardianOwner(request.resource.data.familyId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAtMillis is int
        && request.resource.data.expiresAtMillis is int
        && request.resource.data.expiresAtMillis > request.time.toMillis()
        && request.resource.data.expiresAtMillis <= request.time.toMillis() + 900000
        && request.resource.data.claimed == false
        && request.resource.data.claimedByUid == ''
        && request.resource.data.claimedDeviceId == ''
        && request.resource.data.claimedAtMillis == 0;
      allow update: if signedIn()
        && resource.data.claimed == false
        && resource.data.expiresAtMillis > request.time.toMillis()
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAtMillis == resource.data.createdAtMillis
        && request.resource.data.expiresAtMillis == resource.data.expiresAtMillis
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'claimed', 'claimedByUid', 'claimedDeviceId', 'claimedAtMillis'
        ])
        && request.resource.data.claimed == true
        && request.resource.data.claimedByUid == request.auth.uid
        && request.resource.data.claimedDeviceId is string
        && request.resource.data.claimedDeviceId.size() >= 12
        && request.resource.data.claimedDeviceId.size() <= 100
        && request.resource.data.claimedAtMillis is int;
      allow delete: if guardianOwner(resource.data.familyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}