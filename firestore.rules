rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rolePath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/roles/$(request.auth.uid);
    }

    function hasRole(schoolId) {
      return signedIn() && exists(rolePath(schoolId));
    }

    function roleDocument(schoolId) {
      return get(rolePath(schoolId));
    }

    function activeRole(schoolId) {
      return hasRole(schoolId) && roleDocument(schoolId).data.enabled == true;
    }

    function schoolAdmin(schoolId) {
      return activeRole(schoolId) && roleDocument(schoolId).data.level == 'school';
    }

    function allowedTargets() {
      return [
        '1-1', '1-2', '1-3', '1-4', '1-5', '1-6', '1-7', '1-8', '1-9', '1-10',
        '2-1', '2-2', '2-3', '2-4', '2-5', '2-6', '2-7', '2-8', '2-9', '2-10',
        '3-1', '3-2', '3-3', '3-4', '3-5', '3-6', '3-7', '3-8', '3-9', '3-10'
      ];
    }

    function classKeyIsValid(classKey) {
      return classKey is string && classKey in allowedTargets();
    }

    function targetsAreValid(targets) {
      return targets is list
        && targets.size() > 0
        && targets.size() <= 30
        && targets.hasOnly(allowedTargets());
    }

    function canPublishTo(schoolId, targets) {
      return activeRole(schoolId)
        && targetsAreValid(targets)
        && (
          roleDocument(schoolId).data.level == 'school'
          || (
            roleDocument(schoolId).data.classKeys is list
            && targets.hasOnly(roleDocument(schoolId).data.classKeys)
          )
        );
    }

    function studentCanCreateFor(targets) {
      return signedIn()
        && targets is list
        && targets.size() == 1
        && targets.hasOnly(allowedTargets());
    }

    function studentCanEditExisting() {
      return signedIn()
        && targetsAreValid(request.resource.data.targets)
        && request.resource.data.targets == resource.data.targets;
    }

    function validContent(schoolId) {
      return request.resource.data.schoolId == schoolId
        && request.resource.data.kind in ['notice', 'schedule', 'supply', 'event', 'group']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000;
    }

    function validPoll() {
      return classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 120
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 8
        && request.resource.data.multiple is bool
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.deleted is bool
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int;
    }

    function pollPath(schoolId, pollId) {
      return /databases/$(database)/documents/schools/$(schoolId)/polls/$(pollId);
    }

    function validDriveItem(groupId) {
      return classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.groupId == groupId
        && request.resource.data.type in ['link', 'note']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.deleted is bool
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int;
    }

    function validAssignment() {
      return classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.dueAtMs is int
        && request.resource.data.groupId is string
        && request.resource.data.deleted is bool
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int;
    }

    match /schools/{schoolId}/content/{contentId} {
      allow read: if true;

      allow create: if validContent(schoolId)
        && (
          studentCanCreateFor(request.resource.data.targets)
          || canPublishTo(schoolId, request.resource.data.targets)
        );

      allow update: if validContent(schoolId)
        && (
          studentCanEditExisting()
          || canPublishTo(schoolId, request.resource.data.targets)
        );

      allow delete: if false;
    }

    match /schools/{schoolId}/history/{historyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['create', 'update', 'delete', 'restore']
        && request.resource.data.contentId is string
        && targetsAreValid(request.resource.data.targets);
      allow update, delete: if false;
    }

    // 5. 빠른 투표: 누구나 만들 수 있고, 질문/선택지는 생성 후 고정한다.
    match /schools/{schoolId}/polls/{pollId} {
      allow read: if signedIn();
      allow create: if signedIn() && validPoll() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && validPoll()
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.question == resource.data.question
        && request.resource.data.options == resource.data.options
        && request.resource.data.multiple == resource.data.multiple
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAtMs == resource.data.createdAtMs;
      allow delete: if false;

      match /votes/{voteId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && voteId == request.auth.uid
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.selected is list
          && request.resource.data.selected.size() > 0
          && request.resource.data.selected.size() <= 8
          && get(pollPath(schoolId, pollId)).data.status == 'open'
          && get(pollPath(schoolId, pollId)).data.deleted == false;
        allow delete: if false;
      }
    }

    // 1. 모둠 공유함: 파일 업로드 없이 링크와 텍스트를 Firestore에서 공유한다.
    match /schools/{schoolId}/groupDrive/{groupId}/items/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && validDriveItem(groupId) && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && validDriveItem(groupId)
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.type == resource.data.type
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAtMs == resource.data.createdAtMs;
      allow delete: if false;
    }

    // 2. 과제 허브: 공유 과제 + 사용자별 개인 진행 상태.
    match /schools/{schoolId}/assignments/{assignmentId} {
      allow read: if signedIn();
      allow create: if signedIn() && validAssignment() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && validAssignment()
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAtMs == resource.data.createdAtMs;
      allow delete: if false;

      match /progress/{userId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create, update: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.state in ['todo', 'doing', 'done']
          && request.resource.data.updatedAtMs is int;
        allow delete: if false;
      }
    }

    match /schools/{schoolId}/roles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if schoolAdmin(schoolId);
    }

    match /schools/{schoolId}/neisTimetables/{timetableId} {
      allow read: if true;
      allow write: if false;
    }

    match /schools/{schoolId}/meals/{mealId} {
      allow read: if true;
      allow write: if false;
    }

    match /schools/{schoolId}/pushSubscriptions/{subscriptionId} {
      allow read, delete: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly([
          'token', 'classKey', 'enabled', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.classKey in allowedTargets()
        && request.resource.data.enabled is bool;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
