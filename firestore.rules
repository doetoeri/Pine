rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rolePath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/roles/$(request.auth.uid);
    }

    function hasRole(schoolId) {
      return signedIn() && exists(rolePath(schoolId));
    }

    function roleDocument(schoolId) {
      return get(rolePath(schoolId));
    }

    function activeRole(schoolId) {
      return hasRole(schoolId) && roleDocument(schoolId).data.enabled == true;
    }

    function schoolAdmin(schoolId) {
      return activeRole(schoolId) && roleDocument(schoolId).data.level == 'school';
    }

    // 회장 기능은 화면에서 버튼을 숨기는 것과 별개로 서버 규칙에서도 검사한다.
    function classOperator(schoolId, classKey) {
      return activeRole(schoolId)
        && classKeyIsValid(classKey)
        && (
          roleDocument(schoolId).data.level == 'school'
          || (
            roleDocument(schoolId).data.level in ['class', 'grade', 'president']
            && roleDocument(schoolId).data.classKeys is list
            && classKey in roleDocument(schoolId).data.classKeys
          )
        );
    }

    function validClassOpsBase(classKey) {
      return classKeyIsValid(classKey)
        && request.resource.data.classKey == classKey
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int
        && request.resource.data.updatedAtMs >= request.resource.data.createdAtMs
        && request.resource.data.deleted is bool;
    }

    function validTitle(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function validWorksheetMetadata() {
      return request.resource.data.unit is string
        && request.resource.data.unit.size() <= 80
        && request.resource.data.materialType in ['worksheet', 'summary', 'assignment', 'exam', 'answer', 'other']
        && request.resource.data.schoolYear is int
        && request.resource.data.schoolYear >= 2000
        && request.resource.data.schoolYear <= 2100
        && request.resource.data.semester in [1, 2]
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 20
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount >= 0
        && request.resource.data.pageCount <= 999
        && request.resource.data.sourceAttribution is string
        && request.resource.data.sourceAttribution.size() <= 300
        && request.resource.data.rightsBasis in ['teacher-approved', 'self-made', 'open-license', 'official-public']
        && (
          !(request.resource.data.rightsBasis in ['open-license', 'official-public'])
          || request.resource.data.sourceAttribution.size() > 0
        )
        && request.resource.data.rightsConfirmed == true
        && request.resource.data.personalDataRemoved == true;
    }

    function validAnswerAt(answers, index) {
      return answers.size() <= index
        || (
          answers[index] is string
          && answers[index].size() > 0
          && answers[index].size() <= 120
        );
    }

    function validEventAnswers(answers) {
      return answers is list
        && answers.size() > 0
        && answers.size() <= 12
        && validAnswerAt(answers, 0)
        && validAnswerAt(answers, 1)
        && validAnswerAt(answers, 2)
        && validAnswerAt(answers, 3)
        && validAnswerAt(answers, 4)
        && validAnswerAt(answers, 5)
        && validAnswerAt(answers, 6)
        && validAnswerAt(answers, 7)
        && validAnswerAt(answers, 8)
        && validAnswerAt(answers, 9)
        && validAnswerAt(answers, 10)
        && validAnswerAt(answers, 11);
    }

    function officialPoll() {
      return request.resource.data.get('official', false) == true;
    }

    function allowedTargets() {
      return [
        '1-1', '1-2', '1-3', '1-4', '1-5', '1-6', '1-7', '1-8', '1-9', '1-10',
        '2-1', '2-2', '2-3', '2-4', '2-5', '2-6', '2-7', '2-8', '2-9', '2-10',
        '3-1', '3-2', '3-3', '3-4', '3-5', '3-6', '3-7', '3-8', '3-9', '3-10'
      ];
    }

    function classKeyIsValid(classKey) {
      return classKey is string && classKey in allowedTargets();
    }

    function targetsAreValid(targets) {
      return targets is list
        && targets.size() > 0
        && targets.size() <= 30
        && targets.hasOnly(allowedTargets());
    }

    function canPublishTo(schoolId, targets) {
      return activeRole(schoolId)
        && targetsAreValid(targets)
        && (
          roleDocument(schoolId).data.level == 'school'
          || (
            roleDocument(schoolId).data.classKeys is list
            && targets.hasOnly(roleDocument(schoolId).data.classKeys)
          )
        );
    }

    function studentCanCreateFor(targets) {
      return signedIn()
        && targets is list
        && targets.size() == 1
        && targets.hasOnly(allowedTargets());
    }

    function studentCanEditExisting() {
      return signedIn()
        && targetsAreValid(request.resource.data.targets)
        && request.resource.data.targets == resource.data.targets;
    }

    function validContent(schoolId) {
      return request.resource.data.schoolId == schoolId
        && request.resource.data.kind in ['notice', 'schedule', 'supply', 'event', 'group']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000;
    }

    function validPoll() {
      return classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 120
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 8
        && validEventAnswers(request.resource.data.options)
        && request.resource.data.multiple is bool
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.deleted is bool
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int;
    }

    function pollPath(schoolId, pollId) {
      return /databases/$(database)/documents/schools/$(schoolId)/polls/$(pollId);
    }

    function eventPath(schoolId, eventId) {
      return /databases/$(database)/documents/schools/$(schoolId)/events/$(eventId);
    }

    function supplyPath(schoolId, supplyId) {
      return /databases/$(database)/documents/schools/$(schoolId)/supplies/$(supplyId);
    }

    function validDriveItem(groupId) {
      return classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.groupId == groupId
        && request.resource.data.type in ['link', 'note']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.deleted is bool
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int;
    }

    function validAssignment() {
      return classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.dueAtMs is int
        && request.resource.data.groupId is string
        && request.resource.data.deleted is bool
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int;
    }

    function validVisit() {
      return request.resource.data.keys().hasOnly([
          'userUid', 'classKey', 'day', 'startedAtMs', 'lastSeenMs',
          'beta', 'device', 'appVersion', 'closed'
        ])
        && request.resource.data.userUid is string
        && request.resource.data.userUid == request.auth.uid
        && classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.startedAtMs is int
        && request.resource.data.lastSeenMs is int
        && request.resource.data.lastSeenMs >= request.resource.data.startedAtMs
        && request.resource.data.beta is bool
        && request.resource.data.device in ['mobile', 'tablet', 'desktop']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 40
        && request.resource.data.closed is bool;
    }

    match /schools/{schoolId}/content/{contentId} {
      allow read: if true;

      allow create: if validContent(schoolId)
        && (
          studentCanCreateFor(request.resource.data.targets)
          || canPublishTo(schoolId, request.resource.data.targets)
        );

      allow update: if validContent(schoolId)
        && (
          studentCanEditExisting()
          || canPublishTo(schoolId, request.resource.data.targets)
        );

      allow delete: if false;
    }

    match /schools/{schoolId}/history/{historyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['create', 'update', 'delete', 'restore']
        && request.resource.data.contentId is string
        && targetsAreValid(request.resource.data.targets);
      allow update, delete: if false;
    }

    // 5. 빠른 투표: 누구나 만들 수 있고, 질문/선택지는 생성 후 고정한다.
    match /schools/{schoolId}/polls/{pollId} {
      allow read: if signedIn() || resource.data.get('official', false) == true;
      allow create: if signedIn()
        && validPoll()
        && request.resource.data.authorUid == request.auth.uid
        && (!officialPoll() || classOperator(schoolId, request.resource.data.classKey));
      allow update: if signedIn()
        && validPoll()
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.question == resource.data.question
        && request.resource.data.options == resource.data.options
        && request.resource.data.multiple == resource.data.multiple
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.get('official', false) == resource.data.get('official', false)
        && (
          (
            officialPoll()
            && classOperator(schoolId, request.resource.data.classKey)
          )
          || (
            !officialPoll()
            && resource.data.authorUid == request.auth.uid
          )
        );
      allow delete: if false;

      match /votes/{voteId} {
        allow read: if signedIn()
          && (
            get(pollPath(schoolId, pollId)).data.get('official', false) == false
            || classOperator(schoolId, get(pollPath(schoolId, pollId)).data.classKey)
            || get(pollPath(schoolId, pollId)).data.get('resultVisibility', 'live') == 'live'
            || get(pollPath(schoolId, pollId)).data.status == 'closed'
            || (
              get(pollPath(schoolId, pollId)).data.get('closesAtMs', 0) > 0
              && get(pollPath(schoolId, pollId)).data.get('closesAtMs', 0) < request.time.toMillis()
            )
          );
        allow create, update: if signedIn()
          && voteId == request.auth.uid
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.selected is list
          && request.resource.data.selected.size() > 0
          && request.resource.data.selected.size() <= 8
          && request.resource.data.selected.hasOnly([0, 1, 2, 3, 4, 5, 6, 7])
          && (
            get(pollPath(schoolId, pollId)).data.multiple == true
            || request.resource.data.selected.size() == 1
          )
          && get(pollPath(schoolId, pollId)).data.status == 'open'
          && get(pollPath(schoolId, pollId)).data.deleted == false
          && (
            get(pollPath(schoolId, pollId)).data.get('closesAtMs', 0) == 0
            || get(pollPath(schoolId, pollId)).data.get('closesAtMs', 0) >= request.time.toMillis()
          );
        allow delete: if false;
      }
    }

    // 1. 모둠 공유함: 파일 업로드 없이 링크와 텍스트를 Firestore에서 공유한다.
    match /schools/{schoolId}/groupDrive/{groupId}/items/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && validDriveItem(groupId) && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && validDriveItem(groupId)
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.type == resource.data.type
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAtMs == resource.data.createdAtMs;
      allow delete: if false;
    }

    // 2. 과제 허브: 공유 과제 + 사용자별 개인 진행 상태.
    match /schools/{schoolId}/assignments/{assignmentId} {
      allow read: if signedIn();
      allow create: if signedIn() && validAssignment() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && validAssignment()
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAtMs == resource.data.createdAtMs;
      allow delete: if false;

      match /progress/{userId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create, update: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.state in ['todo', 'doing', 'done']
          && request.resource.data.updatedAtMs is int;
        allow delete: if false;
      }
    }

    // 방문자 통계: 각 사용자는 자기 세션만 기록할 수 있고, 전체 원자료는 학교 운영자만 읽는다.
    match /schools/{schoolId}/visits/{visitId} {
      allow read: if schoolAdmin(schoolId);
      allow create: if signedIn() && validVisit();
      allow update: if signedIn()
        && validVisit()
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.day == resource.data.day
        && request.resource.data.startedAtMs == resource.data.startedAtMs;
      allow delete: if false;
    }

    match /schools/{schoolId}/roles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if schoolAdmin(schoolId);
    }

    // PinCon 학급 운영: 공지, 수행평가·준비물, 행사와 설정은 회장만 변경한다.
    match /schools/{schoolId}/announcements/{announcementId} {
      allow read: if true;
      allow create, update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && validTitle(request.resource.data.title, 100)
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1800
        && request.resource.data.priority in ['normal', 'important', 'urgent'];
      allow delete: if false;
    }

    match /schools/{schoolId}/classAssignments/{assignmentId} {
      allow read: if true;
      allow create, update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.type in ['assessment', 'exam', 'preparation']
        && validTitle(request.resource.data.title, 120)
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 40
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() == 10
        && request.resource.data.dueAtMs is int
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1200;
      allow delete: if false;
    }

    match /schools/{schoolId}/events/{eventId} {
      allow read: if true;
      allow create, update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.kind in ['survey34', 'family-arcade', 'quiz', 'balance', 'class-vote', 'survey', 'mini-game']
        && validTitle(request.resource.data.title, 120)
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 500
        && request.resource.data.status in ['draft', 'open', 'closed']
        && (
          request.resource.data.get('resultsVisible', false) == true
          || request.resource.data.get('publishedResults', []).size() == 0
        );
      allow delete: if false;
    }

    // 응답 문서에는 이메일, UID, 이름을 저장하지 않는다. 원문은 회장만 읽는다.
    match /schools/{schoolId}/eventResponses/{responseId} {
      allow read: if classOperator(schoolId, resource.data.classKey);
      allow create: if signedIn()
        && responseId.matches('^[0-9a-f]{40}$')
        && request.resource.data.keys().hasOnly(['classKey', 'eventId', 'answers', 'createdAtMs', 'createdAt'])
        && classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.eventId is string
        && exists(eventPath(schoolId, request.resource.data.eventId))
        && get(eventPath(schoolId, request.resource.data.eventId)).data.classKey == request.resource.data.classKey
        && get(eventPath(schoolId, request.resource.data.eventId)).data.status == 'open'
        && get(eventPath(schoolId, request.resource.data.eventId)).data.deleted == false
        && get(eventPath(schoolId, request.resource.data.eventId)).data.acceptingResponses == true
        && get(eventPath(schoolId, request.resource.data.eventId)).data.get('startsAtMs', 0) <= request.time.toMillis()
        && (
          get(eventPath(schoolId, request.resource.data.eventId)).data.get('endsAtMs', 0) == 0
          || get(eventPath(schoolId, request.resource.data.eventId)).data.get('endsAtMs', 0) >= request.time.toMillis()
        )
        && validEventAnswers(request.resource.data.answers)
        && request.resource.data.createdAtMs is int;
      allow update, delete: if false;
    }

    // 공개 건의에는 작성자 식별자를 넣지 않고, 상태와 공식 답변만 회장이 변경한다.
    match /schools/{schoolId}/feedback/{feedbackId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'classKey', 'category', 'title', 'body', 'status', 'officialReply',
          'anonymous', 'deleted', 'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.category in ['시설', '학급 규칙', '공용품', '행사', '학습', '청소', '기타']
        && validTitle(request.resource.data.title, 100)
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1600
        && request.resource.data.status == 'received'
        && request.resource.data.officialReply == ''
        && request.resource.data.anonymous == true;
      allow update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.category == resource.data.category
        && request.resource.data.status in ['received', 'reviewing', 'planned', 'completed', 'difficult']
        && request.resource.data.officialReply is string
        && request.resource.data.officialReply.size() <= 1600;
      allow delete: if false;
    }

    match /schools/{schoolId}/supplies/{supplyId} {
      allow read: if true;
      allow create, update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && validTitle(request.resource.data.name, 80)
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.status in ['enough', 'low', 'empty']
        && request.resource.data.loanable is bool;
      allow delete: if false;
    }

    match /schools/{schoolId}/supplyReports/{reportId} {
      allow read: if classOperator(schoolId, resource.data.classKey);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['classKey', 'supplyId', 'reporterUid', 'createdAtMs', 'updatedAtMs'])
        && classKeyIsValid(request.resource.data.classKey)
        && request.resource.data.supplyId is string
        && exists(supplyPath(schoolId, request.resource.data.supplyId))
        && get(supplyPath(schoolId, request.resource.data.supplyId)).data.classKey == request.resource.data.classKey
        && get(supplyPath(schoolId, request.resource.data.supplyId)).data.deleted == false
        && request.resource.data.reporterUid == request.auth.uid
        && reportId == request.resource.data.supplyId + '_' + request.auth.uid
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int;
      allow delete: if false;
    }

    // 대여 기록에는 학생 이름·이메일·UID가 없다. 반환 처리는 회장만 한다.
    match /schools/{schoolId}/supplyLoans/{loanId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'classKey', 'supplyId', 'status', 'borrowedAtMs', 'deleted',
          'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.supplyId is string
        && exists(supplyPath(schoolId, request.resource.data.supplyId))
        && get(supplyPath(schoolId, request.resource.data.supplyId)).data.classKey == request.resource.data.classKey
        && get(supplyPath(schoolId, request.resource.data.supplyId)).data.deleted == false
        && get(supplyPath(schoolId, request.resource.data.supplyId)).data.loanable == true
        && request.resource.data.status == 'loaned';
      allow update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.supplyId == resource.data.supplyId
        && request.resource.data.status in ['loaned', 'returned'];
      allow delete: if false;
    }

    match /schools/{schoolId}/lostItems/{lostItemId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'classKey', 'name', 'foundLocation', 'foundDate', 'photoUrl', 'storagePath',
          'status', 'deleted', 'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && validClassOpsBase(request.resource.data.classKey)
        && validTitle(request.resource.data.name, 100)
        && request.resource.data.foundLocation is string
        && request.resource.data.foundLocation.size() <= 120
        && request.resource.data.foundDate is string
        && request.resource.data.foundDate.size() == 10
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 1200
        && request.resource.data.status == 'stored';
      allow update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.classKey == resource.data.classKey
        && request.resource.data.status in ['stored', 'claimed'];
      allow delete: if false;
    }

    match /schools/{schoolId}/resources/{resourceId} {
      allow read: if resource.data.moderationStatus == 'approved'
        || classOperator(schoolId, resource.data.classKey);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'classKey', 'category', 'subject', 'title', 'description', 'url',
          'unit', 'materialType', 'schoolYear', 'semester', 'version', 'pageCount', 'sourceAttribution',
          'fileName', 'storagePath', 'rightsBasis', 'rightsConfirmed', 'personalDataRemoved',
          'pinned', 'moderationStatus', 'deleted',
          'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && validClassOpsBase(request.resource.data.classKey)
        && validTitle(request.resource.data.title, 120)
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1200
        && validWorksheetMetadata()
        && request.resource.data.url is string
        && request.resource.data.url.size() > 0
        && request.resource.data.url.size() <= 1200
        && request.resource.data.url.matches('^https?://.*$')
        && request.resource.data.pinned is bool
        && request.resource.data.moderationStatus in ['pending', 'approved']
        && (
          request.resource.data.moderationStatus == 'pending'
          || classOperator(schoolId, request.resource.data.classKey)
        )
        && (
          request.resource.data.pinned == false
          || classOperator(schoolId, request.resource.data.classKey)
        );
      allow update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.classKey == resource.data.classKey
        && validTitle(request.resource.data.title, 120)
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1200
        && (
          (
            request.resource.data.keys().hasAll(['materialType', 'rightsConfirmed', 'personalDataRemoved'])
            && validWorksheetMetadata()
          )
          || (
            !resource.data.keys().hasAny(['materialType', 'rightsConfirmed', 'personalDataRemoved'])
            && !request.resource.data.keys().hasAny(['materialType', 'rightsConfirmed', 'personalDataRemoved'])
          )
        )
        && request.resource.data.url is string
        && request.resource.data.url.size() > 0
        && request.resource.data.url.size() <= 1200
        && request.resource.data.url.matches('^https?://.*$')
        && request.resource.data.pinned is bool
        && request.resource.data.moderationStatus in ['pending', 'approved'];
      allow delete: if false;
    }

    match /schools/{schoolId}/patchNotes/{patchNoteId} {
      allow read: if true;
      allow create, update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.month is string
        && request.resource.data.month.size() == 7
        && request.resource.data.status == 'published';
      allow delete: if false;
    }

    match /schools/{schoolId}/patchNoteDrafts/{draftId} {
      allow read: if classOperator(schoolId, resource.data.classKey);
      allow create, update: if classOperator(schoolId, request.resource.data.classKey)
        && validClassOpsBase(request.resource.data.classKey)
        && request.resource.data.month is string
        && request.resource.data.month.size() == 7
        && request.resource.data.status == 'draft';
      allow delete: if false;
    }

    match /schools/{schoolId}/classSettings/{classKey} {
      allow read: if true;
      allow create, update: if classOperator(schoolId, classKey)
        && request.resource.data.classKey == classKey;
      allow delete: if false;
    }

    // 변경 기록은 회장만 읽고 쓸 수 있으며 수정·삭제할 수 없다.
    match /schools/{schoolId}/changeLogs/{changeId} {
      allow read: if classOperator(schoolId, resource.data.classKey);
      allow create: if classOperator(schoolId, request.resource.data.classKey)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.collection in [
          'announcements', 'classAssignments', 'events', 'polls', 'feedback',
          'supplies', 'supplyLoans', 'lostItems', 'resources', 'patchNotes',
          'patchNoteDrafts', 'classSettings'
        ]
        && request.resource.data.action in ['create', 'update', 'delete', 'restore', 'publish']
        && request.resource.data.documentId is string
        && request.resource.data.createdAtMs is int;
      allow update, delete: if false;
    }

    match /schools/{schoolId}/neisTimetables/{timetableId} {
      allow read: if true;
      allow write: if false;
    }

    match /schools/{schoolId}/meals/{mealId} {
      allow read: if true;
      allow write: if false;
    }

    match /schools/{schoolId}/academicSchedules/{scheduleId} {
      allow read: if true;
      allow write: if false;
    }

    match /schools/{schoolId}/notificationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /schools/{schoolId}/pushSubscriptions/{subscriptionId} {
      allow read, delete: if false;
      allow create, update: if (
          request.resource.data.keys().hasOnly([
            'token', 'classKey', 'enabled', 'createdAt', 'updatedAt'
          ])
          || (
            signedIn()
            && request.resource.data.keys().hasOnly([
              'token', 'classKey', 'enabled', 'createdAt', 'updatedAt',
              'ownerUid', 'preferences', 'appVersion', 'updatedAtMs'
            ])
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.preferences is map
          )
        )
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.classKey in allowedTargets()
        && request.resource.data.enabled is bool;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
