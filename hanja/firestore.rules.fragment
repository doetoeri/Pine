
    // Hanja cross-device sync: each user can only access their own study state.
    match /hanjaUsers/{userId}/state/{docId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && docId == 'main'
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'currentIndex', 'currentChar', 'updatedAtMs', 'deviceId'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.currentIndex is int
        && request.resource.data.currentIndex >= 0
        && request.resource.data.currentIndex <= 5000
        && request.resource.data.currentChar is string
        && request.resource.data.currentChar.size() > 0
        && request.resource.data.currentChar.size() <= 4
        && request.resource.data.updatedAtMs is int
        && request.resource.data.updatedAtMs > 0
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.deviceId.size() <= 100;
      allow delete: if false;
    }

    match /hanjaUsers/{userId}/progress/{charId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'char', 'grade', 'updatedAtMs', 'deviceId'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.char is string
        && request.resource.data.char == charId
        && request.resource.data.char.size() > 0
        && request.resource.data.char.size() <= 4
        && request.resource.data.grade in ['again', 'hard', 'good']
        && request.resource.data.updatedAtMs is int
        && request.resource.data.updatedAtMs > 0
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.deviceId.size() <= 100;
      allow delete: if false;
    }

    match /hanjaUsers/{userId}/devices/{deviceId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'deviceId', 'label', 'deviceType', 'lastSeenAtMs'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId == deviceId
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.deviceId.size() <= 100
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 40
        && request.resource.data.deviceType in ['mobile', 'tablet', 'desktop']
        && request.resource.data.lastSeenAtMs is int
        && request.resource.data.lastSeenAtMs > 0;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // User-created Hanja entries are private to that Firebase account and sync across devices.
    match /hanjaUsers/{userId}/customEntries/{charId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'char', 'hun', 'eum', 'strokes', 'parts',
          'structure', 'origin', 'memory', 'usage', 'originExtra', 'custom',
          'createdAtMs', 'updatedAtMs'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.char is string
        && request.resource.data.char == charId
        && request.resource.data.char.size() > 0
        && request.resource.data.char.size() <= 4
        && request.resource.data.hun is string
        && request.resource.data.hun.size() <= 30
        && request.resource.data.eum is string
        && request.resource.data.eum.size() <= 20
        && request.resource.data.strokes is number
        && request.resource.data.strokes >= 0
        && request.resource.data.strokes <= 80
        && request.resource.data.parts is list
        && request.resource.data.parts.size() <= 8
        && request.resource.data.structure is string
        && request.resource.data.structure.size() <= 800
        && request.resource.data.origin is string
        && request.resource.data.origin.size() <= 1000
        && request.resource.data.memory is string
        && request.resource.data.memory.size() <= 600
        && request.resource.data.usage is list
        && request.resource.data.usage.size() <= 6
        && request.resource.data.originExtra is map
        && request.resource.data.custom == true
        && request.resource.data.createdAtMs is int
        && request.resource.data.createdAtMs > 0
        && request.resource.data.updatedAtMs is int
        && request.resource.data.updatedAtMs >= request.resource.data.createdAtMs;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
