{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pincon.app/next/data/problem-bank.schema.json",
  "title": "PinCon Problem Bank",
  "type": "object",
  "required": ["schemaVersion", "problems"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classKey", "subject", "unit", "difficulty", "type", "question", "choices", "answer", "explanation", "tags", "source", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^pb-[a-zA-Z0-9-]{6,80}$" },
          "classKey": { "type": "string", "pattern": "^[1-3]-(10|[1-9])$" },
          "subject": { "type": "string", "minLength": 1, "maxLength": 40 },
          "unit": { "type": "string", "minLength": 1, "maxLength": 80 },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "type": { "enum": ["multiple-choice", "short-answer"] },
          "question": { "type": "string", "minLength": 1, "maxLength": 1600 },
          "choices": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "answer": { "type": "string", "minLength": 1, "maxLength": 600 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 2400 },
          "tags": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "note"],
            "properties": {
              "kind": { "enum": ["ai-generated", "self-made", "teacher-approved", "open-license"] },
              "note": { "type": "string", "maxLength": 300 }
            }
          },
          "status": { "enum": ["draft", "published"] }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "multiple-choice" } } },
            "then": { "properties": { "choices": { "minItems": 2 } } }
          },
          {
            "if": { "properties": { "type": { "const": "short-answer" } } },
            "then": { "properties": { "choices": { "maxItems": 0 } } }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
