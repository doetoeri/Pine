rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function safeUpload() {
      return request.resource != null
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType != 'text/html'
        && request.resource.contentType != 'application/javascript'
        && request.resource.contentType != 'text/javascript'
        && request.resource.contentType != 'application/x-msdownload'
        && request.resource.contentType != 'application/x-sh';
    }

    match /schools/{schoolId}/groupDrive/{groupId}/{fileName=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && safeUpload();
      // 실제 파일 삭제는 막아 두고 Firestore 메타데이터만 soft-delete하여 복원 가능하게 한다.
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
